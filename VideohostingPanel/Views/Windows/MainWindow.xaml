<Window x:Class="VideohostingPanel.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideohostingPanel"
        xmlns:elements="clr-namespace:VideohostingPanel.Views.Elements"
        Title="Видеохостинг - Панель управления"
        MinWidth="1200"
        MinHeight="800"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Стиль для кнопок сортировки -->
            <Style x:Key="SortButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{StaticResource DarkTertiaryBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.8,0.2" RadiusX="1.2" RadiusY="1.2">
                <GradientStop Color="#2D0B4A" Offset="0"/>
                <GradientStop Color="#0A0A0A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Rectangle Opacity="0.02">
            <Rectangle.Fill>
                <DrawingBrush Viewport="0,0,20,20" ViewportUnits="Absolute" TileMode="Tile">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="White">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="20,20"/>
                                    <LineGeometry StartPoint="20,0" EndPoint="0,20"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель -->
            <Border Grid.Row="0"
                    Background="{StaticResource DarkSecondaryBrush}"
                    CornerRadius="15"
                    BorderBrush="{StaticResource PrimaryPurpleBrush}"
                    BorderThickness="1"
                    Margin="0,0,0,10"
                    Opacity="0.95">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,15">
                        <TextBlock Text="MyVideo" 
                                  FontSize="20" FontWeight="Bold"
                                  Foreground="{StaticResource PrimaryRedBrush}"/>
                        <TextBlock Text="Admin" 
                                  FontSize="16" Margin="10,0,0,0"
                                  Foreground="{StaticResource PrimaryPurpleBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,15">
                        <TextBlock Text="{Binding UserDisplayName}" 
                                  FontSize="16"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  VerticalAlignment="Center"/>

                        <!-- Кнопка выхода -->
                        <Button Command="{Binding LogoutCommand}"
                                Width="35" Height="35"
                                Background="Transparent" BorderThickness="0"
                                Margin="15,0,0,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="17.5">
                                        <Image Source="/Images/exit_icon.png" Width="15" Height="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Кнопка закрытия -->
                        <Button Command="{Binding CloseApplicationCommand}"
                                Width="35" Height="35"
                                Background="Transparent" BorderThickness="0"
                                Margin="5,0,0,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="17.5">
                                        <Image Source="/Images/close_icon.png" Width="15" Height="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <Border Grid.Row="1"
                    Background="{StaticResource DarkSecondaryBrush}"
                    CornerRadius="15"
                    BorderBrush="{StaticResource PrimaryPurpleBrush}"
                    BorderThickness="1"
                    Opacity="0.95">
                <Grid>
                    <!-- Панель администратора -->
                    <Grid Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Панель выбора и поиска -->
                        <Border Grid.Row="0"
                                Background="{StaticResource DarkTertiaryBrush}"
                                CornerRadius="15,15,0,0" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Таблица:"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,20,0"/>

                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding AvailableTables}"
                                          SelectedItem="{Binding SelectedTable}"
                                          Style="{StaticResource BaseComboBoxStyle}" Width="200"/>

                                <!-- Динамическая панель поиска -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0">

                                    <!-- Поиск по ID (виден всегда) -->
                                    <Border Background="{StaticResource DarkSecondaryBrush}"
                                            CornerRadius="14"
                                            BorderBrush="{StaticResource PrimaryPurpleBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="ID:" FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,5,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding SearchIdText}"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                                     VerticalAlignment="Center" Padding="5,0" MaxLength="10"/>
                                            <Button Grid.Column="2" Content="Найти" Command="{Binding SearchByIdCommand}"
                                                    Style="{StaticResource BaseButtonStyle}" Height="35" Width="70"
                                                    Margin="0,0,5,0" FontSize="12"/>
                                        </Grid>
                                    </Border>

                                    <!-- Поиск по имени (виден для Video, User, Emploee) -->
                                    <Border Background="{StaticResource DarkSecondaryBrush}"
                                            CornerRadius="14"
                                            BorderBrush="{StaticResource PrimaryPurpleBrush}"
                                            BorderThickness="1"
                                            Margin="10,0,0,0"
                                            Visibility="{Binding IsNameSearchVisible, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Имя:" FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,5,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding SearchNameText}"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                                     VerticalAlignment="Center" Padding="5,0"/>
                                            <Button Grid.Column="2" Content="Найти" Command="{Binding SearchByNameCommand}"
                                                    Style="{StaticResource BaseButtonStyle}" Height="35" Width="70"
                                                    Margin="0,0,5,0" FontSize="12"/>
                                        </Grid>
                                    </Border>

                                    <!-- Поиск по тексту (виден только для Comment) -->
                                    <Border Background="{StaticResource DarkSecondaryBrush}"
                                            CornerRadius="14"
                                            BorderBrush="{StaticResource PrimaryPurpleBrush}"
                                            BorderThickness="1"
                                            Margin="10,0,0,0"
                                            Visibility="{Binding IsTextSearchVisible, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Текст:" FontSize="14"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="10,0,5,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding SearchText}"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                                     VerticalAlignment="Center" Padding="5,0"/>
                                            <Button Grid.Column="2" Content="Найти" Command="{Binding SearchByTextCommand}"
                                                    Style="{StaticResource BaseButtonStyle}" Height="35" Width="70"
                                                    Margin="0,0,5,0" FontSize="12"/>
                                        </Grid>
                                    </Border>

                                    <!-- Выпадающий список типов логов (виден только для ServerLog) -->
                                    <ComboBox ItemsSource="{Binding LogTypes}"
                                              SelectedItem="{Binding SelectedLogType}"
                                              Style="{StaticResource BaseComboBoxStyle}"
                                              Width="150" Margin="10,0,0,0"
                                              Visibility="{Binding IsLogTypeVisible, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>

                                <!-- Кнопки сортировки -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="20,0,0,0">
                                    <TextBlock Text="Сортировка:"
                                               FontSize="14"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>

                                    <Button Command="{Binding SortAscendingCommand}"
                                            Style="{StaticResource SortButtonStyle}" Margin="0,0,5,0">
                                        <Image Source="/Resources/Images/ic_arrow_down.png" Width="12" Height="12"/>
                                    </Button>

                                    <Button Command="{Binding SortDescendingCommand}"
                                            Style="{StaticResource SortButtonStyle}">
                                        <Image Source="/Resources/Images/ic_arrow_up.png" Width="12" Height="12"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Контейнер для записей -->
                        <Border Grid.Row="1" Background="Transparent" Margin="0">
                            <ScrollViewer Style="{StaticResource BaseScrollViewerStyle}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Style="{StaticResource ItemsStackPanelStyle}">

                                    <!-- Кнопка "+" — всегда первая -->
                                    <elements:AddItemControl Visibility="{Binding IsAddButtonVisible, 
                                                            Converter={StaticResource BoolToVis}}"/>

                                    <!-- Элементы записей -->
                                    <ItemsControl ItemsSource="{Binding Records}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ContentPresenter Content="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Нижняя панель пагинации -->
                        <Border Grid.Row="2"
                                Background="{StaticResource DarkTertiaryBrush}"
                                CornerRadius="0,0,15,15" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0"
                                        Command="{Binding LoadPreviousCommand}"
                                        Content="Предыдущие 10 записей"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Background="{StaticResource DarkBackgroundBrush}"
                                        Height="40" Width="250" FontSize="14" Margin="0,0,20,0"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding PageInfo}" Margin="10,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="14" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalItemsInfo}" Margin="10,0"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Command="{Binding LoadNextCommand}"
                                        Content="Следующие 10 записей"
                                        Style="{StaticResource BaseButtonStyle}"
                                        Background="{StaticResource DarkBackgroundBrush}"
                                        Height="40" Width="250" FontSize="14"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Панель верификатора -->
                    <Grid Visibility="{Binding IsVerifier, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource HeaderGradient}"
                                CornerRadius="15,15,0,0" Padding="20">
                            <TextBlock Text="Неверифицированные видео"
                                       FontSize="24" FontWeight="Bold"
                                       Foreground="White"/>
                        </Border>

                        <Border Grid.Row="1" Background="Transparent" Margin="0">
                            <ScrollViewer Style="{StaticResource BaseScrollViewerStyle}"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding UnverifiedVideos}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>