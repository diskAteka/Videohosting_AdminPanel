<Window x:Class="VideohostingPanel.Views.Windows.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900"
        Height="750"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Основной контейнер -->
    <Border x:Name="RootBorder" CornerRadius="20" Background="Transparent">
        <Border.Effect>
            <DropShadowEffect Color="#8A2BE2" BlurRadius="30" Opacity="0.5" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Border CornerRadius="20" Background="{StaticResource DarkBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Верхняя градиентная полоса -->
                    <Border Grid.Row="0" 
                            Background="{StaticResource HeaderGradient}" 
                            CornerRadius="20,20,0,0"/>

                    <!-- Заголовок с кнопкой закрытия -->
                    <Grid Grid.Row="1" 
                          Background="{StaticResource DarkSecondaryBrush}"
                          MouseDown="Window_MouseDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="25,15,0,15">
                            <!-- Иконка замка -->
                            <Image Source="/Resources/Images/ic_lock.png" 
                                   Width="20" 
                                   Height="20" 
                                   Margin="0,0,10,0" 
                                   VerticalAlignment="Center"/>
                            <TextBlock Text="СБРОС ПАРОЛЯ"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="30"
                                Height="30"
                                FontSize="16"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,15,0"
                                Click="CloseButton_Click">
                            <Button.Content>
                                <!-- Иконка закрытия (крестик) -->
                                <Image Source="/Resources/Images/ic_close.png" 
                                       Width="25" 
                                       Height="25"/>
                            </Button.Content>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="15">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#33FF0000"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Основное содержимое -->
                    <ScrollViewer Grid.Row="2" 
                                  Style="{StaticResource BaseScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Disabled">
                        <Grid Margin="40,30,40,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Секция информации о пользователе -->
                            <TextBlock Grid.Row="0"
                                       Text="ИНФОРМАЦИЯ О ПОЛЬЗОВАТЕЛЕ"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,20"
                                       Opacity="0.7"/>

                            <!-- ID пользователя -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource DarkSecondaryBrush}"
                                    CornerRadius="14"
                                    Padding="20,15"
                                    Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="ID"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Width="80"/>

                                    <Border Grid.Column="1"
                                            Background="{StaticResource DarkTertiaryBrush}"
                                            CornerRadius="10"
                                            Padding="15,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock x:Name="UserIdText"
                                                       Grid.Column="0"
                                                       Text="USR-2024-7845"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                                            <Border Grid.Column="1"
                                                    Background="#15FF0000"
                                                    CornerRadius="8"
                                                    Padding="8,4"
                                                    Margin="10,0,0,0">
                                                <!-- Иконка замка (только чтение) -->
                                                <Image Source="/Resources/Images/ic_lock.png" 
                                                       Width="12" 
                                                       Height="12"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Имя пользователя -->
                            <Border Grid.Row="2"
                                    Background="{StaticResource DarkSecondaryBrush}"
                                    CornerRadius="14"
                                    Padding="20,15"
                                    Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Имя"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Width="80"/>

                                    <Border Grid.Column="1"
                                            Background="{StaticResource DarkTertiaryBrush}"
                                            CornerRadius="10"
                                            Padding="15,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock x:Name="UserNameText"
                                                       Grid.Column="0"
                                                       Text="Иван Петров"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                                            <Border Grid.Column="1"
                                                    Background="#15FF0000"
                                                    CornerRadius="8"
                                                    Padding="8,4"
                                                    Margin="10,0,0,0">
                                                <!-- Иконка замка (только чтение) -->
                                                <Image Source="/Resources/Images/ic_lock.png" 
                                                       Width="12" 
                                                       Height="12"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Email пользователя -->
                            <Border Grid.Row="3"
                                    Background="{StaticResource DarkSecondaryBrush}"
                                    CornerRadius="14"
                                    Padding="20,15"
                                    Margin="0,0,0,30">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="Email"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               Width="80"/>

                                    <Border Grid.Column="1"
                                            Background="{StaticResource DarkTertiaryBrush}"
                                            CornerRadius="10"
                                            Padding="15,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock x:Name="UserEmailText"
                                                       Grid.Column="0"
                                                       Text="ivan.petrov@example.com"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>

                                            <Border Grid.Column="1"
                                                    Background="#15FF0000"
                                                    CornerRadius="8"
                                                    Padding="8,4"
                                                    Margin="10,0,0,0">
                                                <!-- Иконка замка (только чтение) -->
                                                <Image Source="/Resources/Images/ic_lock.png" 
                                                       Width="12" 
                                                       Height="12"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Разделитель -->
                            <Border Grid.Row="4"
                                    Height="2"
                                    Background="{StaticResource DarkTertiaryBrush}"
                                    CornerRadius="1"
                                    Margin="0,0,0,25"/>

                            <!-- Секция сброса пароля (выделенная) -->
                            <Grid Grid.Row="5">
                                <Border Background="{StaticResource DarkSecondaryBrush}"
                                        CornerRadius="16"
                                        BorderBrush="{StaticResource OutlineBorderGradient}"
                                        BorderThickness="2"
                                        Padding="25,20">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#FF0000" 
                                                         BlurRadius="25" 
                                                         Opacity="0.3" 
                                                         ShadowDepth="0"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Заголовок секции пароля -->
                                        <StackPanel Grid.Row="0" 
                                                    Orientation="Horizontal" 
                                                    Margin="0,0,0,15">
                                            <TextBlock Text="НОВЫЙ ПАРОЛЬ"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <Border Background="#33FF0000"
                                                    CornerRadius="8"
                                                    Padding="8,4"
                                                    Margin="15,0,0,0">
                                                <TextBlock Text="Обязательное поле"
                                                           FontSize="11"
                                                           Foreground="#FF6666"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Подсказка -->
                                        <TextBlock Grid.Row="1"
                                                   Text="Пароль должен содержать минимум 6 до 16 символов"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,15"
                                                   Opacity="0.7"/>

                                        <!-- Поле ввода пароля -->
                                        <Border x:Name="PasswordBorder"
                                                Grid.Row="2"
                                                Background="{StaticResource DarkTertiaryBrush}"
                                                CornerRadius="14"
                                                BorderBrush="{StaticResource OutlineBorderGradient}"
                                                BorderThickness="2"
                                                Height="55">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Иконка пароля -->
                                                <Image Source="/Resources/Images/ic_key.png" 
                                                       Width="20" 
                                                       Height="20" 
                                                       Margin="15,0,10,0"
                                                       VerticalAlignment="Center"/>

                                                <!-- Новый пароль всегда отображается открытым текстом -->
                                                <TextBox x:Name="PasswordInput"
                                                         Grid.Column="1"
                                                         Style="{StaticResource BaseTextBoxStyle}"
                                                         TextChanged="PasswordInput_TextChanged"
                                                         Margin="0,5"
                                                         FontSize="18"
                                                         FontWeight="SemiBold"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         VerticalContentAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>

                    <!-- Панель кнопок -->
                    <Border Grid.Row="3"
                            Background="{StaticResource DarkSecondaryBrush}"
                            CornerRadius="0,0,20,20"
                            Padding="20,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Кнопка отмены -->
                            <Button Grid.Column="0"
                                    Content="ОТМЕНА"
                                    Style="{StaticResource RejectOutlinedButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Width="140"
                                    Height="50"
                                    Click="CancelButton_Click"/>

                            <!-- Кнопка сброса пароля -->
                            <Button Grid.Column="2"
                                    Content="СБРОСИТЬ ПАРОЛЬ"
                                    Style="{StaticResource OutlinedButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Margin="0,0,10,0"
                                    Width="200"
                                    Height="50"
                                    Click="ResetPasswordButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>