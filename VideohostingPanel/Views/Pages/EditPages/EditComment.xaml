<Page x:Class="VideohostingPanel.Views.Pages.EditPages.EditComment"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:services="clr-namespace:VideohostingPanel.Services"
      xmlns:converters="clr-namespace:VideohostingPanel.Converters"
      mc:Ignorable="d"
      Title="EditCommentPage"
      MinWidth="1200" MinHeight="800"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.8,0.2" RadiusX="1.2" RadiusY="1.2">
                <GradientStop Color="#2D0B4A" Offset="0"/>
                <GradientStop Color="#0A0A0A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Кнопка назад -->
            <Border Grid.Row="0" Background="Transparent" Margin="0,0,0,10" HorizontalAlignment="Left">
                <Button Command="{Binding GoBackCommand}"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="{StaticResource DarkBackgroundBrush}"
                        Width="100" Height="35" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resources/Images/ic_arrow_back.png" Width="10" Height="10" Margin="0,0,5,0"/>
                        <TextBlock Text="Назад"/>
                    </StackPanel>
                </Button>
            </Border>

            <!-- Контейнер для формы -->
            <Border Grid.Row="1"
                    Background="{StaticResource DarkSecondaryBrush}"
                    CornerRadius="20"
                    BorderBrush="{StaticResource PrimaryPurpleBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderGradient}"
                            CornerRadius="20,20,0,0" Height="70">
                        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Форма -->
                    <ScrollViewer Grid.Row="1" Style="{StaticResource BaseScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20">
                            <!-- ID комментария -->
                            <TextBlock Text="ID комментария" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <TextBox Text="{Binding Comment.Id}" Style="{StaticResource BaseTextBoxStyle}" Padding="3"
                                     IsReadOnly="True" Background="{StaticResource DarkBackgroundBrush}" Margin="0,0,0,15"/>

                            <!-- Видео -->
                            <TextBlock Text="Видео" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding Videos}" SelectedItem="{Binding SelectedVideo}"
                                          DisplayMemberPath="DisplayName" Padding="3"
                                          Style="{StaticResource BaseComboBoxStyle}" Margin="0,0,10,0"/>
                                <Border Grid.Column="1" Background="{StaticResource DarkBackgroundBrush}"
                                        CornerRadius="14" BorderBrush="{StaticResource PrimaryPurpleBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ID:" FontSize="14"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="10,0,5,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding VideoSearchId}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                                 VerticalAlignment="Center" Padding="5,0" MaxLength="10"/>
                                        <Button Grid.Column="2" Content="Найти" Command="{Binding SearchVideoByIdCommand}"
                                                Style="{StaticResource BaseButtonStyle}" Height="35" Width="60"
                                                Margin="0,0,5,0" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Пользователь -->
                            <TextBlock Text="Автор комментария" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                          DisplayMemberPath="DisplayName" Padding="3"
                                          Style="{StaticResource BaseComboBoxStyle}" Margin="0,0,10,0"/>
                                <Border Grid.Column="1" Background="{StaticResource DarkBackgroundBrush}"
                                        CornerRadius="14" BorderBrush="{StaticResource PrimaryPurpleBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ID:" FontSize="14"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="10,0,5,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding UserSearchId}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                                 VerticalAlignment="Center" Padding="5,0" MaxLength="10"/>
                                        <Button Grid.Column="2" Content="Найти" Command="{Binding SearchUserByIdCommand}"
                                                Style="{StaticResource BaseButtonStyle}" Height="35" Width="60"
                                                Margin="0,0,5,0" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Текст комментария -->
                            <TextBlock Text="Текст комментария *" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <TextBox Text="{Binding Comment.Text}" Style="{StaticResource BaseTextBoxStyle}" Padding="3"
                                     Height="120" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,15"/>

                            <!-- Дата и время загрузки -->
                            <TextBlock Text="Дата и время загрузки" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <DatePicker Grid.Column="0" Padding="3"
                                            SelectedDate="{Binding SelectedUploadDate}"
                                            Style="{StaticResource BaseDatePickerStyle}"/>

                                <TextBlock Grid.Column="1" 
                                           Text="Время (ЧЧ:ММ):" 
                                           VerticalAlignment="Center"
                                           Margin="15,0,10,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"/>

                                <TextBox Grid.Column="2" 
                                         Text="{Binding UploadTime, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BaseTextBoxStyle}" Height="40" Padding="3"
                                         Margin="0"/>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Кнопки действий-->
                    <Border Grid.Row="2" 
                            Background="{StaticResource DarkTertiaryBrush}" 
                            CornerRadius="0,0,20,20" 
                            Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Кнопка удалить-->
                            <Button Content="Удалить запись" 
                                    Grid.Column="0"
                                    Command="{Binding DeleteCommand}"
                                    Background="#66FF0000" 
                                    Style="{StaticResource BaseButtonStyle}"
                                    Height="45" 
                                    Margin="10"
                                    HorizontalAlignment="Left" 
                                    Width="150"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Grid.Column="3" HorizontalAlignment="Right" Style="{StaticResource OutlinedButtonStyle}"
                                    Content="Сохранить" Width="250" Margin="10"
                                    Command="{Binding SaveAsyncCommand}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Height="10" Background="Transparent"/>
        </Grid>
    </Grid>
</Page>