<Page x:Class="VideohostingPanel.Views.Pages.VerifyVideo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:converters="clr-namespace:VideohostingPanel.Converters"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="VerifyVideoPage"
      MinWidth="1200" MinHeight="600"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:MuteSoundConverter x:Key="MuteSoundConverter"/>
            <converters:PlayPauseConvertor x:Key="PlayPauseConvertor"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid x:Name="RootGrid" Margin="0,0,0,0">
        <Grid.Background>
            <RadialGradientBrush Center="0.8,0.2" RadiusX="1.2" RadiusY="1.2">
                <GradientStop Color="#2D0B4A" Offset="0"/>
                <GradientStop Color="#0A0A0A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid x:Name="ContentGrid" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Кнопка назад -->
            <Border x:Name="BackButtonPanel" Grid.Row="0" Background="Transparent" Margin="0,0,0,10" HorizontalAlignment="Left">
                <Button Command="{Binding GoBackCommand}"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="{StaticResource DarkBackgroundBrush}"
                        Width="100" Height="35" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resources/Images/ic_arrow_back.png" Width="10" Height="10" Margin="0,0,5,0"/>
                        <TextBlock Text="Назад"/>
                    </StackPanel>
                </Button>
            </Border>

            <!-- Контейнер для формы -->
            <Border x:Name="FormBorder" Grid.Row="1"
                    Background="{StaticResource DarkSecondaryBrush}"
                    CornerRadius="20"
                    BorderBrush="{StaticResource PrimaryPurpleBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border x:Name="FormHeader" Grid.Row="0"
                            Background="{StaticResource HeaderGradient}"
                            CornerRadius="20,20,0,0" Height="70">
                        <TextBlock Text="Верификация видео" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Форма -->
                    <ScrollViewer x:Name="FormScroll" Grid.Row="1" Style="{StaticResource BaseScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="FormStack" Margin="20">
                            <!-- Информация о видео -->
                            <Border x:Name="VideoInfoPanel" Background="{StaticResource DarkTertiaryBrush}" CornerRadius="15" Padding="20" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding PosterImageSource}" Width="120" Height="90"
                                           Stretch="UniformToFill" Margin="0,0,20,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Video.Name}" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="Автор:" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Video.AuthorName}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryPurpleBrush}" Margin="5,0,10,0"/>
                                            <TextBlock Text="Загружено:" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Video.DateUpload, StringFormat=\{0:dd.MM.yyyy\}}"
                                                       FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Описание:" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,15,0,5"/>
                                        <TextBlock Text="{Binding Video.Description}" TextWrapping="Wrap"
                                                   FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border x:Name="VideoContainer" Height="420" MinHeight="260" Margin="0,0,0,20" Background="Black"
                                    BorderBrush="{StaticResource PrimaryPurpleBrush}" BorderThickness="1"
                                    CornerRadius="15" ClipToBounds="True" Padding="0,20,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Хост всегда видим: HWND должен существовать с реальными размерами -->
                                    <WindowsFormsHost Grid.Row="0" x:Name="VideoHost" >
                                        <!-- VLC плеер будет добавлен программно -->
                                    </WindowsFormsHost>

                                    <!-- Оверлей загрузки рисуется поверх хоста -->
                                    <Border Grid.Row="0" Background="#80000000"
                                            Visibility="{Binding IsVideoLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel VerticalAlignment="Center">
                                            <ProgressBar IsIndeterminate="True" Height="5" Margin="0,0,0,0"/>
                                            <TextBlock Text="Загрузка видео..." FontSize="18" HorizontalAlignment="Center"
                                                       Foreground="White" Margin="20"/>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="ControlsBorder" Grid.Row="1" Background="#CC000000" CornerRadius="0,0,15,15" Padding="10,6">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Command="{Binding PlayPauseCommand}"
                                                    Style="{StaticResource PlayerControlButtonStyle}"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding IsPause, Converter={StaticResource PlayPauseConvertor}}" Width="16" Height="16"/>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="{Binding CurrentTime}" Foreground="White"
                                                        VerticalAlignment="Center" Margin="8,0,5,0" FontSize="12"/>
                                            <Slider Grid.Column="2"
                                                    Value="{Binding VideoSliderPosition, Mode=OneWay}"
                                                    Minimum="0" Maximum="1"
                                                    Style="{StaticResource VideoSliderStyle}"
                                                    IsMoveToPointEnabled="False"
                                                    VerticalAlignment="Center" Margin="5,0"
                                                    PreviewMouseDown="VideoSlider_PreviewMouseDown"
                                                    PreviewMouseUp="VideoSlider_PreviewMouseUp"
                                                    LostMouseCapture="VideoSlider_LostMouseCapture"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalTime}" Foreground="White"
                                                        VerticalAlignment="Center" Margin="5,0,8,0" FontSize="12"/>
                                            <Button Grid.Column="4" Command="{Binding MuteUnmuteCommand}"
                                                    Style="{StaticResource PlayerControlButtonStyle}"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding IsMute, Converter={StaticResource MuteSoundConverter}}" Width="16" Height="16"/>
                                            </Button>
                                            <Slider Grid.Column="5"
                                                    Value="{Binding VolumeSliderPosition, Mode=TwoWay}"
                                                    Minimum="0" Maximum="1"
                                                    Style="{StaticResource VideoSliderStyle}"
                                                    Width="80" VerticalAlignment="Center" Margin="5,0"
                                                    ValueChanged="VolumeSlider_ValueChanged"/>
                                            <Button Grid.Column="6" Command="{Binding ToggleFullScreenCommand}"
                                                    Style="{StaticResource PlayerControlButtonStyle}"
                                                    VerticalAlignment="Center"
                                                    ToolTip="Полный экран (F11)">
                                                <Image Source="/Resources/Images/FullScreen.png" Width="16" Height="16"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>


                            <!-- Дополнительная информация -->
                            <Border x:Name="ExtraInfoPanel" Background="{StaticResource DarkTertiaryBrush}" CornerRadius="15" Padding="20" Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                                        <Image Source="/Resources/Images/ic_view.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Video.Views}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                                        <Image Source="/Resources/Images/ic_like.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Video.Likes}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Resources/Images/ic_dislike.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Video.Dislikes}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Кнопки действий -->
                    <Border x:Name="ActionButtonsPanel" Grid.Row="2" Background="{StaticResource DarkTertiaryBrush}" CornerRadius="0,0,20,20" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Отклонить" Command="{Binding RejectCommand}"
                                    Style="{StaticResource RejectOutlinedButtonStyle}" Width="250" Height="45" Margin="10"/>
                            <Button Grid.Column="3" Content="Принять" Command="{Binding ApproveCommand}"
                                    Style="{StaticResource OutlinedButtonStyle}" Width="250" Height="45" Margin="10"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>