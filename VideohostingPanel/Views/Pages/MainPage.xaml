<Page x:Class="VideohostingPanel.Views.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="MainPage"
      MinWidth="1200" MinHeight="800"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.8,0.2" RadiusX="1.2" RadiusY="1.2">
                <GradientStop Color="#2D0B4A" Offset="0"/>
                <GradientStop Color="#0A0A0A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель: Выбор таблицы, поиск, выход -->
            <Border Grid.Row="0" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- ComboBox выбора таблицы -->
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding AvailableTables}"
                              SelectedItem="{Binding SelectedTable}"
                              Style="{StaticResource BaseComboBoxStyle}"
                              Width="250"/>

                    <!-- Панель поиска -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0">
                        <TextBox Text="{Binding SearchByIdText}" 
                                 Style="{StaticResource BaseTextBoxStyle}"
                                 Width="150" Margin="0,0,10,0"
                                 Visibility="{Binding IsIdSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBox Text="{Binding SearchByNameOrText}" 
                                 Style="{StaticResource BaseTextBoxStyle}"
                                 Width="200" Margin="0,0,10,0"
                                 Visibility="{Binding IsTextSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <ComboBox ItemsSource="{Binding LogTypes}"
                                  SelectedItem="{Binding SelectedLogType}"
                                  Style="{StaticResource BaseComboBoxStyle}"
                                  Width="150" Margin="0,0,10,0"
                                  Visibility="{Binding IsLogTypeSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <Button Content="Искать"
                                Command="{Binding SearchCommand}"
                                Style="{StaticResource BaseButtonStyle}"
                                Height="45" Width="100"/>
                    </StackPanel>

                    <!-- Кнопка выхода -->
                    <Button Grid.Column="2" 
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource BaseButtonStyle}"
                            Background="{StaticResource DarkBackgroundBrush}"
                            Width="100" Height="45" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/exit_icon.png" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Выйти"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Список записей -->
            <ScrollViewer Grid.Row="1" Style="{StaticResource BaseScrollViewerStyle}"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ItemsPanel" Style="{StaticResource ItemsStackPanelStyle}">
                    <!-- UserControl с иконкой "+" для создания новой записи -->
                    <Border Background="{StaticResource DarkTertiaryBrush}"
                            CornerRadius="15" Margin="0,0,0,15"
                            BorderBrush="{StaticResource PrimaryPurpleBrush}" BorderThickness="1"
                            Cursor="Hand"
                            Visibility="{Binding IsAddButtonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding AddNewRecordCommand}"/>
                        </Border.InputBindings>
                        <Grid Margin="15" HorizontalAlignment="Center">
                            <Image Source="/Images/plus_icon.png" Width="40" Height="40"/>
                        </Grid>
                    </Border>

                    <!-- Место для элементов списка. Они будут добавляться динамически через ItemsControl -->
                    <ItemsControl ItemsSource="{Binding Records}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Здесь будет селектор шаблонов для разных UserControl, 
                                     например, CommentItemControl, VideoItemControl и т.д. -->
                                <ContentPresenter Content="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Панель пагинации снизу -->
            <Border Grid.Row="2" Margin="0,15,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding PreviousPageCommand}"
                            Style="{StaticResource BaseButtonStyle}"
                            Width="100" Height="40" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/Images/arrow_left.png" Width="16" Height="16" Margin="0,0,5,0"/>
                            <TextBlock Text="Назад"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{Binding CurrentPage}" 
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center" Margin="20,0"/>

                    <Button Command="{Binding NextPageCommand}"
                            Style="{StaticResource BaseButtonStyle}"
                            Width="100" Height="40" Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Вперед"/>
                            <Image Source="/Images/arrow_right.png" Width="16" Height="16" Margin="5,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
