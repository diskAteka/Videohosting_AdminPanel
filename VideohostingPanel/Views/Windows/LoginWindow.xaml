<Window x:Class="VideohostingPanel.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VideohostingPanel"
        xmlns:services="clr-namespace:VideohostingPanel.Services"
        xmlns:converters="clr-namespace:VideohostingPanel.Converters"
        Title="Вход в систему"
        Width="550"
        Height="800"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.8,0.2" RadiusX="1.2" RadiusY="1.2">
                <GradientStop Color="#2D0B4A" Offset="0"/>
                <GradientStop Color="#0A0A0A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Border Background="{StaticResource DarkSecondaryBrush}"
            CornerRadius="20"
            BorderBrush="{StaticResource PrimaryPurpleBrush}"
            BorderThickness="1"
            Width="500"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <StackPanel Margin="30">
                <!-- Заголовок -->
                <Image Source="/Resources/Images/VVideo — full.png" Height="40"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Администрирование БД"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <!-- Адрес сервера -->
                <TextBlock Text="Адрес сервера" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding ServerAddress}" Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,15"/>

                <!-- Порт -->
                <TextBlock Text="Порт" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Port}" Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,15"/>

                <!-- Имя пользователя -->
                <TextBlock Text="Имя пользователя" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5"/>
                <TextBox Text="{Binding UserName}" Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,15"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5"/>
                <PasswordBox Style="{StaticResource BasePasswordBoxStyle}" 
                         services:PasswordBoxHelper.BindPassword="{Binding Password, Mode=TwoWay}"
                         Margin="0,0,0,20"/>

                <!-- Сообщение об ошибке -->
                <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource PrimaryRedBrush}"
                       FontSize="12" TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Visibility="{Binding IsErrorVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                       Margin="0,0,0,15"
                       x:Name="ErrorTextBlock"/>

                <!-- Кнопка Войти -->
                <Button Content="ВОЙТИ"
                    Command="{Binding LoginCommand}"
                    Style="{StaticResource OutlinedButtonStyle}"
                    Width="200" Margin="0,10,0,0"
                    HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>