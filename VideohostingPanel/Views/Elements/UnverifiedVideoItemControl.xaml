<UserControl x:Class="VideohostingPanel.Views.Elements.UnverifiedVideoItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource DarkTertiaryBrush}"
            CornerRadius="15" Margin="0,0,0,15"
            BorderBrush="{StaticResource PrimaryRedBrush}" BorderThickness="1.5"
            Cursor="Hand">
        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenVerificationPageCommand}"/>
        </Border.InputBindings>

        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Source="{Binding PosterUrl}" Width="80" Height="45"
                   Stretch="UniformToFill" Margin="0,0,15,0"
                   VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Images/unverified_badge.png" Width="16" Height="16" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
                <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                    <Run Text="Загружено: "/>
                    <Run Text="{Binding DateUpload, StringFormat=\{0:dd.MM.yyyy\}}" Foreground="{StaticResource PrimaryPurpleBrush}"/>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>