<UserControl x:Class="VideohostingPanel.Views.Elements.CommentItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource DarkTertiaryBrush}"
            CornerRadius="15" Margin="0,0,0,15"
            BorderBrush="{StaticResource PrimaryPurpleBrush}" BorderThickness="1"
            Cursor="Hand">
        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenEditWindowCommand}"/>
        </Border.InputBindings>
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Аватар -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    Width="50" Height="50"
                    Background="{StaticResource DarkBackgroundBrush}"
                    CornerRadius="25" Margin="0,0,15,0">
                <Image Source="/Resources/Images/Person.png" Width="30" Height="30"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Верхняя строка: автор и видео -->
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,5">
                <TextBlock Text="{Binding UserName}" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text=" комментирует " FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="5,0"/>
                <TextBlock Text="{Binding VideoTitle}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryPurpleBrush}"/>
            </StackPanel>

            <!-- Дата -->
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Resources/Images/Clock.png" Width="12" Height="12"/>
                <TextBlock Text="{Binding Date, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="5,0,0,0"/>
            </StackPanel>

            <!-- Текст комментария -->
            <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                    Background="{StaticResource DarkBackgroundBrush}"
                    CornerRadius="10" Padding="12,8" Margin="0,5,0,0">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" MaxHeight="60"/>
            </Border>
        </Grid>
    </Border>
</UserControl>