<Page x:Class="VideohostingPanel.Views.Pages.EditPages.EditUser"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:converters="clr-namespace:VideohostingPanel.Converters"
      xmlns:services="clr-namespace:VideohostingPanel.Services"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="EditUserPage"
      MinWidth="1200" MinHeight="800"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.8,0.2" RadiusX="1.2" RadiusY="1.2">
                <GradientStop Color="#2D0B4A" Offset="0"/>
                <GradientStop Color="#0A0A0A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Кнопка назад -->
            <Border Grid.Row="0" Background="Transparent" Margin="0,0,0,10" HorizontalAlignment="Left">
                <Button Command="{Binding GoBackCommand}"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="{StaticResource DarkBackgroundBrush}"
                        Width="100" Height="35" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resources/Images/ic_arrow_back.png" Width="10" Height="10" Margin="0,0,5,0"/>
                        <TextBlock Text="Назад"/>
                    </StackPanel>
                </Button>
            </Border>

            <!-- Контейнер для формы -->
            <Border Grid.Row="1"
                    Background="{StaticResource DarkSecondaryBrush}"
                    CornerRadius="20"
                    BorderBrush="{StaticResource PrimaryPurpleBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderGradient}"
                            CornerRadius="20,20,0,0" Height="70">
                        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Форма -->
                    <ScrollViewer Grid.Row="1" Style="{StaticResource BaseScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20">
                            <!-- ID -->
                            <TextBlock Text="ID" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <TextBox Text="{Binding User.Id}" Style="{StaticResource BaseTextBoxStyle}" Padding="3"
                                     IsReadOnly="True" Background="{StaticResource DarkBackgroundBrush}" Margin="0,0,0,15"/>

                            <!-- Имя пользователя -->
                            <TextBlock Text="Имя (3-50 символов) *" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <TextBox Text="{Binding User.Name}" Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,15" Padding="5"/>

                            <!-- Email -->
                            <TextBlock Text="Email *" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <TextBox Text="{Binding User.Email}" Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,15" Padding="5"/>

                            <!-- Пароль -->
                            <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}" >
                                <TextBlock Text="Пароль (6-16 символов) *" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                                <PasswordBox Style="{StaticResource BasePasswordBoxStyle}" Margin="0,0,0,15" Padding="5"                                            
                                             services:PasswordBoxHelper.BindPassword="{Binding Password, Mode=TwoWay}"/>
                            </StackPanel>


                            <!-- Статусы -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Статус" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <CheckBox IsChecked="{Binding User.IsActive}" Content="Активен"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Права" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                                    <CheckBox IsChecked="{Binding User.CanUpload}" Content="Может загружать"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"/>
                                </StackPanel>
                            </Grid>

                            <!-- Дата и время загрузки -->
                            <TextBlock Text="Дата и время регистрации" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <DatePicker Grid.Column="0" Padding="3"
                                            SelectedDate="{Binding RegisterDateSelected}"
                                            Style="{StaticResource BaseDatePickerStyle}"/>

                                <TextBlock Grid.Column="1" 
                                           Text="Время (ЧЧ:ММ):" 
                                           VerticalAlignment="Center"
                                           Margin="15,0,10,0"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"/>

                                <TextBox Grid.Column="2" 
                                         Text="{Binding UploadTime, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource BaseTextBoxStyle}" Height="45" Padding="3"
                                         Margin="0"/>
                            </Grid>


                        </StackPanel>
                    </ScrollViewer>

                    <!-- Кнопки действий -->
                    <Border Grid.Row="2" Background="{StaticResource DarkTertiaryBrush}" CornerRadius="0,0,20,20" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Кнопка удалить -->
                            <Button Grid.Column="0" Content="Удалить запись" Command="{Binding DeleteUserCommand}"
                                    Background="#66FF0000" Style="{StaticResource BaseButtonStyle}"
                                    Height="45" Margin="10" HorizontalAlignment="Left" Width="150"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            
                            <!-- Кнопка сброса пароля -->
                            <Button Grid.Column="2" Content="Сбросить пароль" Command="{Binding ResetPasswordCommand}"
                                    Style="{StaticResource RejectOutlinedButtonStyle}" 
                                    Background="{StaticResource DarkTertiaryBrush}"
                                    Height="45" Margin="10" HorizontalAlignment="Right" Width="250"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                            <Button Grid.Column="3" Content="Сохранить" Command="{Binding SaveChangesCommand}"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource OutlinedButtonStyle}" Width="250" Margin="10"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Height="10" Background="Transparent"/>
        </Grid>
    </Grid>
</Page>