<Window x:Class="VideohostingPanel.Resources.Elements.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="450"
        Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <!-- Цветовая схема -->
            <Color x:Key="DarkBackground">#0A0A0A</Color>
            <Color x:Key="DarkSecondary">#1A1A1A</Color>
            <Color x:Key="DarkTertiary">#2A2A2A</Color>
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#CCCCCC</Color>

            <SolidColorBrush x:Key="DarkBackgroundBrush" Color="#0A0A0A"/>
            <SolidColorBrush x:Key="DarkSecondaryBrush" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CCCCCC"/>

            <!-- Градиенты -->
            <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#FF0000" Offset="0.0"/>
                <GradientStop Color="#8A2BE2" Offset="0.5"/>
                <GradientStop Color="#2D0B4A" Offset="1.0"/>
            </LinearGradientBrush>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Основной контейнер с тенью -->
    <Border CornerRadius="20" Background="Transparent">
        <Border.Effect>
            <DropShadowEffect Color="#8A2BE2" BlurRadius="30" Opacity="0.5" ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <!-- Основная рамка -->
            <Border CornerRadius="20" Background="{StaticResource DarkBackgroundBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Верхняя градиентная полоса -->
                    <Border Grid.Row="0" 
                            Background="{StaticResource HeaderGradient}" 
                            CornerRadius="20,20,0,0"/>

                    <!-- Заголовок с кнопкой закрытия -->
                    <Grid Grid.Row="1" 
                          Background="{StaticResource DarkSecondaryBrush}"
                          MouseDown="Window_MouseDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Информация"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="25,15,0,15"/>

                        <Button Grid.Column="1"
                                Content="✕"
                                Width="30"
                                Height="30"
                                FontSize="16"
                                Background="Transparent"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,15,0"
                                Click="CloseButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="15">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#33FF0000"/>
                                            <Setter Property="Foreground" Value="#FF0000"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Содержимое сообщения -->
                    <Grid Grid.Row="2" Margin="30,20,30,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="60"
                                Height="60"
                                CornerRadius="30"
                                Background="#33FF0000"
                                Margin="0,0,20,0">
                            <Image x:Name="IconImage"
                                   Width="35"
                                   Height="35"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="MessageText"
                                   Grid.Column="1"
                                   Text="Сообщение"
                                   FontSize="16"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"/>
                    </Grid>

                    <StackPanel x:Name="ButtonPanel"
                                Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="20"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>