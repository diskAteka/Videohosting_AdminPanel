<Page x:Class="VideohostingPanel.Views.Pages.AddPages.AddVideo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:converters="clr-namespace:VideohostingPanel.Converters"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="AddVideoPage"    
      MinWidth="1200" MinHeight="800"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="0,0,0,-307">
        <Grid.Background>
            <RadialGradientBrush Center="0.8,0.2" RadiusX="1.2" RadiusY="1.2">
                <GradientStop Color="#2D0B4A" Offset="0"/>
                <GradientStop Color="#0A0A0A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Кнопка назад -->
            <Border Grid.Row="0" Background="Transparent" Margin="0,0,0,10" HorizontalAlignment="Left">
                <Button Command="{Binding GoBackCommand}"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="{StaticResource DarkBackgroundBrush}"
                        Width="100" Height="35" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resources/Images/ic_arrow_back.png" Width="10" Height="10" Margin="0,0,5,0"/>
                        <TextBlock Text="Назад"/>
                    </StackPanel>
                </Button>
            </Border>

            <!-- Контейнер для формы -->
            <Border Grid.Row="1"
                    Background="{StaticResource DarkSecondaryBrush}"
                    CornerRadius="20"
                    BorderBrush="{StaticResource PrimaryPurpleBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderGradient}"
                            CornerRadius="20,20,0,0" Height="70">
                        <TextBlock Text="Добавление видео" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Форма -->
                    <ScrollViewer Grid.Row="1" Style="{StaticResource BaseScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20">
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Зона загрузки постера -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Постер" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                                    <TextBlock Text="Поддерживаемые форматы: .jpg, .png." 
                                                Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,10"/>
                                    <Border Background="{StaticResource DarkTertiaryBrush}" 
                                            BorderBrush="{StaticResource PrimaryPurpleBrush}" 
                                            BorderThickness="2" 
                                            CornerRadius="14" 
                                            Height="100" 
                                            Cursor="Hand"
                                            Margin="0,0,0,15">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding BrowsePosterFileCommand}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Image Source="/Resources/Images/ic_upload.png" Width="40" Height="40" Margin="0,0,0,5"
                                                        Visibility="{Binding PosterIsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding PosterFileName, TargetNullValue='Перетащите файл или кликните для выбора'}" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" 
                                                           FontSize="12" 
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                                
                                
                                <!-- Зона загрузки видео -->
                                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                    <TextBlock Text="Видеофайл *" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                                    <TextBlock Text="Поддерживаемый формат: .mp3. Максимальный размер: 2 ГБ." 
                                                Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,10"/>
                                    <Border Background="{StaticResource DarkTertiaryBrush}" 
                                             BorderBrush="{StaticResource PrimaryPurpleBrush}" 
                                             BorderThickness="2" 
                                             CornerRadius="14" 
                                             Height="100" 
                                             Cursor="Hand"
                                             Margin="0,0,0,15">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick" Command="{Binding BrowseVideoFileCommand}"/>
                                        </Border.InputBindings>
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Image Source="/Resources/Images/ic_upload.png" Width="40" Height="40" Margin="0,0,0,5" 
                                                        Visibility="{Binding VideoIsSelected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding VideoFileName, TargetNullValue='Перетащите файл или кликните для выбора'}" 
                                                            Foreground="{StaticResource TextSecondaryBrush}" 
                                                            FontSize="12" 
                                                            HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Название -->
                            <TextBlock Text="Название видео *" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <TextBox Text="{Binding Video.Name, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,15" Padding="5"/>

                            <!-- Описание -->
                            <TextBlock Text="Описание" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <TextBox Text="{Binding Video.Description, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource BaseTextBoxStyle}" 
                                     Height="100" Padding="5"
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,15"/>

                            <!-- Автор -->
                            <TextBlock Text="Автор (ID)" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding Authors}" SelectedItem="{Binding SelectedAuthor}"
                                          DisplayMemberPath="DisplayName" Padding="3"
                                          Style="{StaticResource BaseComboBoxStyle}" Margin="0,0,10,0"/>
                                <Border Grid.Column="1" Background="{StaticResource DarkBackgroundBrush}"
                                        CornerRadius="14" BorderBrush="{StaticResource PrimaryPurpleBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="ID:" FontSize="14"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="10,0,5,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding AuthorSearchId}"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                                                 VerticalAlignment="Center" Padding="5,0" MaxLength="10"/>
                                        <Button Grid.Column="2" Content="Найти" Command="{Binding SearchAuthorByIdCommand}"
                                                Style="{StaticResource BaseButtonStyle}" Height="35" Width="60"
                                                Margin="0,0,5,0" FontSize="11"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <!-- Статус верификации -->
                                    <TextBlock Text="Статус верификации" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                                    <ComboBox ItemsSource="{Binding VerificationStatuses}" Width="200" HorizontalAlignment="Left"
                                      SelectedItem="{Binding SelectedVerificationStatus}"
                                      Style="{StaticResource BaseComboBoxStyle}" Margin="0,0,0,15"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">

                                    <!-- Дата и время загрузки -->
                                    <TextBlock Text="Дата и время загрузки" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <DatePicker Grid.Column="0" Padding="3"
                                                    SelectedDate="{Binding SelectedUploadDate}"
                                                    Style="{StaticResource BaseDatePickerStyle}"/>

                                        <TextBlock Grid.Column="1" 
                                                   Text="Время (ЧЧ:ММ):" 
                                                   VerticalAlignment="Center"
                                                   Margin="15,0,10,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"/>

                                        <TextBox Grid.Column="2" 
                                                 Text="{Binding UploadTime, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource BaseTextBoxStyle}" Height="45" Padding="3"
                                                 Margin="0"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                            


                           

                            <!-- Статистика -->
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Просмотры" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding Video.Views}" Style="{StaticResource BaseTextBoxStyle}" Height="40" Margin="0,5,5,0" Padding="3"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Лайки" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding Video.Likes}" Style="{StaticResource BaseTextBoxStyle}" Height="40" Margin="5,5,5,0" Padding="3"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Дизлайки" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Text="{Binding Video.Dislikes}" Style="{StaticResource BaseTextBoxStyle}" Height="40" Margin="5,5,0,0" Padding="3"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Кнопки действий -->
                    <Border Grid.Row="3" Background="{StaticResource DarkTertiaryBrush}" CornerRadius="0,0,20,20" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Кнопка удалить -->
                            <Button Grid.Column="0" Content="Удалить запись" Command="{Binding DeleteCommand}"
                                    Background="#66FF0000" Style="{StaticResource BaseButtonStyle}"
                                    Height="45" Margin="10" HorizontalAlignment="Left" Width="150"/>
                            
                            <Button Grid.Column="3" Content="Создать запись" HorizontalAlignment="Right"
                                    Command="{Binding CreateVideoCommand}"
                                    Style="{StaticResource OutlinedButtonStyle}" Width="250" Margin="10" Height="45"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Height="10" Background="Transparent"/>
        </Grid>
    </Grid>
</Page>