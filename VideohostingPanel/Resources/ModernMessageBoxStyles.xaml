<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Цветовая схема -->
    <Color x:Key="DarkBackground">#0A0A0A</Color>
    <Color x:Key="DarkSecondary">#1A1A1A</Color>
    <Color x:Key="DarkTertiary">#2A2A2A</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#CCCCCC</Color>
    <Color x:Key="AccentRed">#FF0000</Color>
    <Color x:Key="AccentPurple">#8A2BE2</Color>

    <SolidColorBrush x:Key="DarkBackgroundBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="DarkSecondaryBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CCCCCC"/>

    <!-- Градиенты -->
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0000" Offset="0.0"/>
        <GradientStop Color="#8A2BE2" Offset="0.5"/>
        <GradientStop Color="#2D0B4A" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Градиент для основной кнопки -->
    <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0000" Offset="0.0"/>
        <GradientStop Color="#8A2BE2" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Градиент для основной кнопки при наведении -->
    <LinearGradientBrush x:Key="PrimaryButtonHoverBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF3333" Offset="0.0"/>
        <GradientStop Color="#9B4DFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Стиль кнопки закрытия -->
    <Style x:Key="CloseButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#33FF0000"/>
                <Setter Property="Foreground" Value="#FF0000"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Базовый стиль для кнопок действий -->
    <Style x:Key="ActionButtonBaseStyle" TargetType="Button">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="10,0,10,20"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background"
                                    Value="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль основной кнопки (ОК, Да, Принять) -->
    <Style x:Key="PrimaryActionButtonStyle" 
           TargetType="Button" 
           BasedOn="{StaticResource ActionButtonBaseStyle}">
        <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}"/>
        <!-- Цвет при наведении будет браться из Tag -->
        <Setter Property="Tag" Value="{StaticResource PrimaryButtonHoverBrush}"/>
    </Style>

    <!-- Стиль второстепенной кнопки (Отмена, Нет) -->
    <Style x:Key="SecondaryActionButtonStyle" 
           TargetType="Button" 
           BasedOn="{StaticResource ActionButtonBaseStyle}">
        <Setter Property="Background" Value="#2A2A2A"/>
        <!-- Цвет при наведении будет браться из Tag -->
        <Setter Property="Tag" Value="#3A3A3A"/>
    </Style>

</ResourceDictionary>