<Page x:Class="VideohostingPanel.Views.Pages.AddPages.AddVideo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:converters="clr-namespace:VideohostingPanel.Converters"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="AddVideoPage"    
      MinWidth="1200" MinHeight="800"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.8,0.2" RadiusX="1.2" RadiusY="1.2">
                <GradientStop Color="#2D0B4A" Offset="0"/>
                <GradientStop Color="#0A0A0A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Кнопка назад -->
            <Border Grid.Row="0" Background="Transparent" Margin="0,0,0,10" HorizontalAlignment="Left">
                <Button Command="{Binding GoBackCommand}"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="{StaticResource DarkBackgroundBrush}"
                        Width="100" Height="35" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resources/Images/ic_arrow_back.png" Width="10" Height="10" Margin="0,0,5,0"/>
                        <TextBlock Text="Назад"/>
                    </StackPanel>
                </Button>
            </Border>

            <!-- Контейнер для формы -->
            <Border Grid.Row="1"
                    Background="{StaticResource DarkSecondaryBrush}"
                    CornerRadius="20"
                    BorderBrush="{StaticResource PrimaryPurpleBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderGradient}"
                            CornerRadius="20,20,0,0" Height="70">
                        <TextBlock Text="Добавление видео" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Форма -->
                    <ScrollViewer Grid.Row="1" Style="{StaticResource BaseScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20">
                            <!-- Зона загрузки видео -->
                            <TextBlock Text="Видеофайл *" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <TextBlock Text="Поддерживаемый формат: .mp3. Максимальный размер: 2 ГБ." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,10"/>
                            <Border Background="{StaticResource DarkTertiaryBrush}" 
                                    BorderBrush="{StaticResource PrimaryPurpleBrush}" 
                                    BorderThickness="2" 
                                    CornerRadius="14" 
                                    Height="100" 
                                    Cursor="Hand"
                                    Margin="0,0,0,15">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding BrowseVideoFileCommand}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image Source="/Resources/Images/ic_upload_video.png" Width="60" Height="50" Margin="0,0,0,5" />
                                        <TextBlock Text="{Binding VideoFileName, TargetNullValue='Перетащите файл или кликните для выбора'}" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                                   FontSize="12" 
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Зона загрузки постера -->
                            <TextBlock Text="Постер" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <TextBlock Text="Поддерживаемые форматы: .jpg, .png." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,10"/>
                            <Border Background="{StaticResource DarkTertiaryBrush}" 
                                    BorderBrush="{StaticResource PrimaryPurpleBrush}" 
                                    BorderThickness="2" 
                                    CornerRadius="14" 
                                    Height="100" 
                                    Cursor="Hand"
                                    Margin="0,0,0,15">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding BrowsePosterFileCommand}"/>
                                </Border.InputBindings>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image Source="/Resources/Images/ic_upload_poster.png" Width="30" Height="30" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding PosterFileName, TargetNullValue='Перетащите файл или кликните для выбора'}" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                                   FontSize="12" 
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Название -->
                            <TextBlock Text="Название видео *" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <TextBox Text="{Binding Video.Name, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,15"/>

                            <!-- Описание -->
                            <TextBlock Text="Описание" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <TextBox Text="{Binding Video.Description, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource BaseTextBoxStyle}" 
                                     Height="100" 
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,15"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Панель уведомлений -->
                    <Border Grid.Row="2" x:Name="NotificationPanel" 
                            Background="#2A2A2A" 
                            CornerRadius="10" 
                            Margin="20,0,20,15" 
                            Padding="15,10"
                            Visibility="{Binding IsNotificationVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Border.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="NotificationIcon" Source="/Resources/Images/ic_warning.png" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock x:Name="NotificationText" 
                                       Text="{Binding NotificationMessage}" 
                                       Foreground="{Binding NotificationColor}" 
                                       VerticalAlignment="Center" 
                                       FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки действий -->
                    <Border Grid.Row="3" Background="{StaticResource DarkTertiaryBrush}" CornerRadius="0,0,20,20" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Кнопка удалить -->
                            <Button Grid.Column="0" Content="УДАЛИТЬ ВИДЕО" Command="{Binding DeleteCommand}"
                                    Background="#66FF0000" Style="{StaticResource BaseButtonStyle}"
                                    Height="45" Margin="10" HorizontalAlignment="Center" Width="250"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            
                            <Button Grid.Column="3" Content="Создать запись" 
                                    Command="{Binding CreateVideoCommand}"
                                    Style="{StaticResource OutlinedButtonStyle}" Width="250" Margin="10" Height="45"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Height="10" Background="Transparent"/>
        </Grid>
    </Grid>
</Page>