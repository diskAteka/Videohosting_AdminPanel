<Page x:Class="VideohostingPanel.Views.Pages.VerifyVideo"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="VerifyVideoPage"
      MinWidth="1200" MinHeight="800"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.8,0.2" RadiusX="1.2" RadiusY="1.2">
                <GradientStop Color="#2D0B4A" Offset="0"/>
                <GradientStop Color="#0A0A0A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Кнопка назад -->
            <Border Grid.Row="0" Background="Transparent" Margin="0,0,0,10" HorizontalAlignment="Left">
                <Button Command="{Binding GoBackCommand}"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="{StaticResource DarkBackgroundBrush}"
                        Width="100" Height="35" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Resources/Images/ic_arrow_back.png" Width="10" Height="10" Margin="0,0,5,0"/>
                        <TextBlock Text="Назад"/>
                    </StackPanel>
                </Button>
            </Border>

            <!-- Контейнер для формы -->
            <Border Grid.Row="1"
                    Background="{StaticResource DarkSecondaryBrush}"
                    CornerRadius="20"
                    BorderBrush="{StaticResource PrimaryPurpleBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderGradient}"
                            CornerRadius="20,20,0,0" Height="70">
                        <TextBlock Text="Верификация видео" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Форма -->
                    <ScrollViewer Grid.Row="1" Style="{StaticResource BaseScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20">
                            <!-- Информация о видео -->
                            <Border Background="{StaticResource DarkTertiaryBrush}" CornerRadius="15" Padding="20" Margin="0,0,0,20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Video.PosterUrl}" Width="120" Height="90"
                                           Stretch="UniformToFill" Margin="0,0,20,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Video.Name}" FontSize="22" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="Автор:" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Video.AuthorName}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource PrimaryPurpleBrush}" Margin="5,0,10,0"/>
                                            <TextBlock Text="Загружено:" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding Video.DateUpload, StringFormat=\{0:dd.MM.yyyy\}}"
                                                       FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" Margin="5,0,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="Описание:" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,15,0,5"/>
                                        <TextBlock Text="{Binding Video.Description}" TextWrapping="Wrap"
                                                   FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="20"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Видеоплеер -->
                            <Border Background="{StaticResource DarkBackgroundBrush}" CornerRadius="15" Padding="0"
                                    Margin="0,0,0,20" BorderBrush="{StaticResource PrimaryPurpleBrush}" BorderThickness="1"
                                    MinHeight="300">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <MediaElement Grid.Row="0"
                                                  Source="{Binding Video.Link}"
                                                  LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                  Stretch="Uniform" ScrubbingEnabled="True"
                                                  x:Name="VideoPlayer"/>
                                    <Border Grid.Row="1" Background="#CC000000" Padding="5" CornerRadius="0,0,15,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Command="{Binding PlayPauseCommand}"
                                                    Style="{StaticResource PlayerControlButtonStyle}">
                                                <Image Source="{Binding PlayPauseIcon}" Width="16" Height="16"/>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="{Binding CurrentTime}" Foreground="White"
                                                       VerticalAlignment="Center" Margin="5,0" FontSize="12"/>
                                            <Slider Grid.Column="2" Value="{Binding Progress}" Minimum="0" Maximum="{Binding Duration}"
                                                    Style="{StaticResource VideoSliderStyle}" VerticalAlignment="Center" Margin="5,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding TotalTime}" Foreground="White"
                                                       VerticalAlignment="Center" Margin="5,0" FontSize="12"/>
                                            <Button Grid.Column="4" Command="{Binding MuteCommand}"
                                                    Style="{StaticResource PlayerControlButtonStyle}">
                                                <Image Source="{Binding MuteIcon}" Width="16" Height="16"/>
                                            </Button>
                                            <Slider Grid.Column="5" Value="{Binding Volume}" Minimum="0" Maximum="1"
                                                    Style="{StaticResource VideoSliderStyle}" Width="80" VerticalAlignment="Center" Margin="5,0"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Дополнительная информация -->
                            <Border Background="{StaticResource DarkTertiaryBrush}" CornerRadius="15" Padding="20" Margin="0,0,0,20">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                                        <Image Source="/Resources/Images/View.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Video.Views}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,30,0">
                                        <Image Source="/Resources/Images/Like.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Video.Likes}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="/Resources/Images/Dislike.png" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Video.Dislikes}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Поле для причины отклонения -->
                            <Border x:Name="RejectCommentBorder"
                                    Background="{StaticResource DarkTertiaryBrush}" CornerRadius="15"
                                    Padding="20" Margin="0,0,0,20"
                                    Visibility="{Binding IsRejectReasonVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="Причина отклонения:" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                    <TextBox Text="{Binding RejectReason}" Style="{StaticResource BaseTextBoxStyle}"
                                             Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </StackPanel>
                            </Border>

                            <!-- Сообщение о результате -->
                            <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,10"
                                       Foreground="{Binding StatusColor}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Кнопки действий -->
                    <Border Grid.Row="2" Background="{StaticResource DarkTertiaryBrush}" CornerRadius="0,0,20,20" Padding="20">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="ПРИНЯТЬ" Command="{Binding ApproveCommand}"
                                    Style="{StaticResource ApproveButtonStyle}" Width="150" Height="50" Margin="10"/>
                            <Button Content="ОТКЛОНИТЬ" Command="{Binding RejectCommand}"
                                    Style="{StaticResource RejectButtonStyle}" Width="150" Height="50" Margin="10"/>
                            <Button Content="Закрыть" Command="{Binding CloseCommand}"
                                    Style="{StaticResource CloseButtonStyle}" Width="100" Height="50" Margin="10"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Height="10" Background="Transparent"/>
        </Grid>
    </Grid>
</Page>