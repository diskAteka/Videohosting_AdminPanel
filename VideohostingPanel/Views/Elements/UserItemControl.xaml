<UserControl x:Class="VideohostingPanel.Views.Elements.UserItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource DarkTertiaryBrush}"
            CornerRadius="15" Margin="0,0,0,15"
            BorderBrush="{StaticResource PrimaryPurpleBrush}" BorderThickness="1"
            Cursor="Hand" MouseLeftButtonUp="Border_Click">

        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Source="/Images/user_icon.png" Width="40" Height="40" Margin="0,0,15,0"
                   VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Email}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="Загрузка:" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding CanUpload}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryPurpleBrush}" Margin="5,0,10,0"/>
                    <TextBlock Text="Активен:" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding IsActive}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryPurpleBrush}" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>