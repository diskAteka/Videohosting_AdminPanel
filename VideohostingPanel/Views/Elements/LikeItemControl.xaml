<UserControl x:Class="VideohostingPanel.Views.Elements.LikeItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource DarkTertiaryBrush}"
            CornerRadius="15" Margin="0,0,0,15"
            BorderBrush="{StaticResource PrimaryPurpleBrush}" BorderThickness="1"
            Cursor="Hand">
        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenEditWindowCommand}"/>
        </Border.InputBindings>

        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Иконка лайка -->
            <Image Source="/Resources/Images/ic_like.png" Width="40" Height="40" Margin="0,0,15,0"
                   VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Пользователь ID:" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding UserId}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryPurpleBrush}" Margin="5,0,10,0"/>
                    <TextBlock Text="Видео ID:" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding VideoId}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryPurpleBrush}" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>