<Page x:Class="VideohostingPanel.Views.Pages.EditPages.EditEmployee"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:services="clr-namespace:VideohostingPanel.Services"
      xmlns:converters="clr-namespace:VideohostingPanel.Converters"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="EditEmployeePage"
      MinWidth="1200" MinHeight="800"
      Background="Transparent">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.Background>
            <RadialGradientBrush Center="0.8,0.2" RadiusX="1.2" RadiusY="1.2">
                <GradientStop Color="#2D0B4A" Offset="0"/>
                <GradientStop Color="#0A0A0A" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Кнопка назад -->
            <Border Grid.Row="0" Background="Transparent" Margin="0,0,0,10" HorizontalAlignment="Left">
                <Button Command="{Binding GoBackCommand}"
                        Style="{StaticResource BaseButtonStyle}"
                        Background="{StaticResource DarkBackgroundBrush}"
                        Width="100" Height="35" FontSize="12">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/arrow_left_purple.png" Width="10" Height="10" Margin="0,0,5,0"/>
                        <TextBlock Text="Назад"/>
                    </StackPanel>
                </Button>
            </Border>

            <!-- Контейнер для формы -->
            <Border Grid.Row="1"
                    Background="{StaticResource DarkSecondaryBrush}"
                    CornerRadius="20"
                    BorderBrush="{StaticResource PrimaryPurpleBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderGradient}"
                            CornerRadius="20,20,0,0" Height="70">
                        <TextBlock Text="Редактирование сотрудника" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Форма -->
                    <ScrollViewer Grid.Row="1" Style="{StaticResource BaseScrollViewerStyle}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20">
                        <StackPanel>
                            <!-- ID сотрудника -->
                            <TextBlock Text="ID сотрудника" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <TextBox Text="{Binding Employee.Id}" Style="{StaticResource BaseTextBoxStyle}"
                                     IsReadOnly="True" Background="{StaticResource DarkBackgroundBrush}" Margin="0,0,0,15"/>

                            <!-- Имя пользователя -->
                            <TextBlock Text="Имя пользователя *" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <TextBox Text="{Binding Employee.UserName}" Style="{StaticResource BaseTextBoxStyle}" Margin="0,0,0,15"/>

                            <!-- Пароль -->
                            <TextBlock Text="Пароль *" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <PasswordBox Style="{StaticResource BasePasswordBoxStyle}"
                                         services:PasswordBoxHelper.BindPassword="{Binding Password}"
                                         Margin="0,0,0,15"/>

                            <!-- Роль -->
                            <TextBlock Text="Роль *" Style="{StaticResource SubHeaderStyle}" Margin="0,0,0,5" FontSize="12"/>
                            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                                      Style="{StaticResource BaseComboBoxStyle}" Margin="0,0,0,15"/>

                            <!-- Кнопка удалить-->
                            <Button Content="УДАЛИТЬ СОТРУДНИКА" 
                                    Command="{Binding DeleteCommand}"
                                    Background="#66FF0000" 
                                    Style="{StaticResource BaseButtonStyle}"
                                    Height="45" 
                                    Margin="0,20,0,0" 
                                    HorizontalAlignment="Center" 
                                    Width="250"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Кнопки действий -->
                    <Border Grid.Row="2" 
                            Background="{StaticResource DarkTertiaryBrush}" 
                            CornerRadius="0,0,20,20" 
                            Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" 
                                    Content="Сохранить" 
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource BaseButtonStyle}" 
                                    Width="120" 
                                    Margin="10"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="2" Height="10" Background="Transparent"/>
        </Grid>
    </Grid>
</Page>