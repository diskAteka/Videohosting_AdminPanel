<UserControl x:Class="VideohostingPanel.Views.Elements.LogItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource DarkTertiaryBrush}"
            CornerRadius="15" Margin="0,0,0,15"
            BorderBrush="{StaticResource PrimaryPurpleBrush}" BorderThickness="1">

        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Image Source="/Resources/Images/ic_info.png" Width="30" Height="30"
                   VerticalAlignment="Center" Margin="0,0,15,0"/>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                           FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock FontSize="11" Margin="0,4,0,0"
                           Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="Таблица:"/>
                    <Run Text="{Binding AffectedTable, Mode=OneWay}"/>
                    <Run Text="  ·  Сотрудник #"/>
                    <Run Text="{Binding UserId, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="{Binding Type}" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Right">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Type}" Value="INSERT">
                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="UPDATE">
                                    <Setter Property="Foreground" Value="#2196F3"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Type}" Value="DELETE">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryRedBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Date, StringFormat=\{0:dd.MM.yy HH:mm:ss\}}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>