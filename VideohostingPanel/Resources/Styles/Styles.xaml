<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--#region Цвета и кисти -->
    <Color x:Key="PrimaryRed">#FF0000</Color>
    <Color x:Key="PrimaryPurple">#8A2BE2</Color>
    <Color x:Key="DarkBackground">#0A0A0A</Color>
    <Color x:Key="DarkSecondary">#1A1A1A</Color>
    <Color x:Key="DarkTertiary">#2A2A2A</Color>
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#CCCCCC</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="PrimaryRedBrush" Color="#FF0000"/>
    <SolidColorBrush x:Key="PrimaryPurpleBrush" Color="#8A2BE2"/>
    <SolidColorBrush x:Key="DarkBackgroundBrush" Color="#0A0A0A"/>
    <SolidColorBrush x:Key="DarkSecondaryBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DarkTertiaryBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CCCCCC"/>

    <!-- Градиентные кисти -->
    <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0000" Offset="0.0"/>
        <GradientStop Color="#8A2BE2" Offset="0.5"/>
        <GradientStop Color="#2D0B4A" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0000" Offset="0.0"/>
        <GradientStop Color="#8A2BE2" Offset="1.0"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ButtonHoverGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF3333" Offset="0.0"/>
        <GradientStop Color="#9B4DFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Градиентная кисть для обводки -->
    <LinearGradientBrush x:Key="OutlineBorderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0000" Offset="0.0"/>
        <GradientStop Color="#8A2BE2" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Кисть для обводки при наведении -->
    <LinearGradientBrush x:Key="OutlineBorderHoverGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF3333" Offset="0.0"/>
        <GradientStop Color="#9B4DFF" Offset="1.0"/>
    </LinearGradientBrush>

    <!--#endregion-->
     
    <!--#region Cтили элементов -->
    
    <!-- Стиль для окна -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource DarkBackgroundBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="AllowsTransparency" Value="True"/>
    </Style>

    <!-- Стиль для кнопки -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonGradient}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}"
                            CornerRadius="14"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="contentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ButtonHoverGradient}"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF0000" BlurRadius="20" Opacity="0.5"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                    </Setter.Value>
                </Setter>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.2"
                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1.02"/>
                            <DoubleAnimation Duration="0:0:0.2"
                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1.02"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.2"
                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1"/>
                            <DoubleAnimation Duration="0:0:0.2"
                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- НОВЫЙ СТИЛЬ: Кнопка с обводкой (Outlined Button) -->
    <Style x:Key="OutlinedButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OutlineBorderGradient}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="contentPresenter"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- При наведении мыши: меняем обводку на более яркую и добавляем фон -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource OutlineBorderHoverGradient}"/>
                            <Setter TargetName="border" Property="Background" Value="#15FF0000"/>
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF0000" BlurRadius="15" Opacity="0.4" ShadowDepth="0"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!-- При нажатии: делаем фон чуть плотнее -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#30FF0000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Анимация при наведении: легкое увеличение -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="1.02" ScaleY="1.02"/>
                    </Setter.Value>
                </Setter>
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.2"
                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1.02"/>
                            <DoubleAnimation Duration="0:0:0.2"
                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1.02"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.2"
                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                             To="1"/>
                            <DoubleAnimation Duration="0:0:0.2"
                                             Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                             To="1"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <!-- Анимация при нажатии: легкое сжатие -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль для текстового поля -->
    <Style x:Key="BaseTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource DarkSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DarkTertiaryBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="15,12"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                        <ScrollViewer x:Name="PART_ContentHost" 
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryRedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryRedBrush}"/>
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF0000" BlurRadius="20" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для пароля -->
    <Style x:Key="BasePasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource DarkSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DarkTertiaryBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="15,12"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14">
                        <ScrollViewer x:Name="PART_ContentHost" 
                                      Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryRedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryRedBrush}"/>
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF0000" BlurRadius="20" Opacity="0.3"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для комбобокса -->
    <Style x:Key="BaseComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource DarkSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DarkTertiaryBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="contentPresenter"
                                                Grid.Column="0"
                                                Margin="15,0,0,0"
                                                VerticalAlignment="Center"
                                                Content="{TemplateBinding SelectionBoxItem}"
                                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                <Path Grid.Column="1"
                                      Width="12"
                                      Height="12"
                                      Margin="0,0,15,0"
                                      Stretch="Fill"
                                      Fill="{StaticResource PrimaryRedBrush}"
                                      Data="M0,0 L4,4 L8,0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{StaticResource DarkSecondaryBrush}"
                                    BorderBrush="{StaticResource PrimaryPurpleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Margin="0,5,0,0"
                                    MaxHeight="200">
                                <ScrollViewer>
                                    <ItemsPresenter Margin="5"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                        <ToggleButton x:Name="toggleButton"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="2"
                                      Focusable="False"
                                      ClickMode="Press"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryRedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для ScrollViewer -->
    <Style x:Key="BaseScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollContentPresenter Grid.Row="0" Grid.Column="0"
                                               Content="{TemplateBinding Content}"
                                               CanContentScroll="{TemplateBinding CanContentScroll}"/>

                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                  Grid.Row="0" Grid.Column="1"
                                  Minimum="0"
                                  Maximum="{TemplateBinding ScrollableHeight}"
                                  Value="{TemplateBinding VerticalOffset}"
                                  ViewportSize="{TemplateBinding ViewportHeight}"
                                  Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                  Background="Transparent"
                                  Width="8"
                                  Margin="2,0,0,0"/>

                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                  Grid.Row="1" Grid.Column="0"
                                  Orientation="Horizontal"
                                  Minimum="0"
                                  Maximum="{TemplateBinding ScrollableWidth}"
                                  Value="{TemplateBinding HorizontalOffset}"
                                  ViewportSize="{TemplateBinding ViewportWidth}"
                                  Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                  Background="Transparent"
                                  Height="8"
                                  Margin="0,2,0,0"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для ScrollBar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Border Background="{StaticResource PrimaryPurpleBrush}"
                                                CornerRadius="4"
                                                Width="8"
                                                Height="8"
                                                Opacity="0.6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для StackPanel с отступами -->
    <Style x:Key="ItemsStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="20"/>
        <Setter Property="Orientation" Value="Vertical"/>
    </Style>

    <!-- Стиль для заголовков -->
    <Style x:Key="HeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="20,20,20,10"/>
    </Style>

    <!-- Стиль для подзаголовков -->
    <Style x:Key="SubHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Margin" Value="20,10"/>
    </Style>

    <!-- Стиль для кнопки "Принять" -->
    <Style x:Key="ApproveButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
        <Setter Property="Content" Value="ПРИНЯТЬ"/>
        <Setter Property="Background" Value="#33FF0000"/>
        <Setter Property="Width" Value="150"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Height" Value="50"/>
    </Style>
    <!-- Стиль для кнопки "Отклонить" -->
    <Style x:Key="RejectButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
        <Setter Property="Content" Value="ОТКЛОНИТЬ"/>
        <Setter Property="Background" Value="{StaticResource DarkTertiaryBrush}"/>
        <Setter Property="Width" Value="150"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Height" Value="50"/>
    </Style>

    <!-- Вариант кнопки "Отклонить" с обводкой -->
    <Style x:Key="RejectOutlinedButtonStyle" BasedOn="{StaticResource OutlinedButtonStyle}" TargetType="Button">
        <Setter Property="Content" Value="ОТКЛОНИТЬ"/>
        <Setter Property="BorderBrush" Value="{StaticResource PrimaryRedBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Width" Value="150"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Height" Value="50"/>
    </Style>

    <!-- Стиль для кнопки закрытия -->
    <Style x:Key="CloseButtonStyle" BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
        <Setter Property="Content" Value="Закрыть"/>
        <Setter Property="Background" Value="{StaticResource DarkBackgroundBrush}"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Height" Value="40"/>
    </Style>

    <!-- Стиль для кнопок управления плеером -->
    <Style x:Key="PlayerControlButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#33FFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль для ползунков -->
    <Style x:Key="VideoSliderStyle" TargetType="Slider">
        <Setter Property="Minimum" Value="0"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="TickFrequency" Value="0.01"/>
        <Setter Property="IsSnapToTickEnabled" Value="False"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Полоса прогресса -->
                        <Border Grid.Row="0"
                            Height="4"
                            Background="#40FFFFFF"
                            CornerRadius="2"
                            Margin="5,0">
                            <Border x:Name="PART_SelectionRange"
                                Height="4"
                                Background="{StaticResource PrimaryPurpleBrush}"
                                CornerRadius="2"
                                HorizontalAlignment="Left"/>
                        </Border>

                        <!-- Ползунок -->
                        <Track Grid.Row="0" x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{x:Null}" 
                                        Command="Slider.DecreaseLarge" 
                                        Background="Transparent"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{x:Null}" 
                                        Command="Slider.IncreaseLarge" 
                                        Background="Transparent"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" 
                                   Width="12" 
                                   Height="12"
                                   Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate>
                                            <Ellipse Width="12" 
                                                Height="12" 
                                                Fill="{StaticResource PrimaryPurpleBrush}"
                                                Stroke="White"
                                                StrokeThickness="2"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Анимация для сообщения об ошибке -->
    <Storyboard x:Key="ShowErrorAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                     From="0"
                     To="1"
                     Duration="0:0:0.3"/>
    </Storyboard>

    <!-- Стиль для CheckBox -->
    <Style x:Key="BaseCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Фон галочки -->
                        <Border x:Name="checkBoxBorder"
                            Grid.Column="0"
                            Width="22"
                            Height="22"
                            Background="{StaticResource DarkSecondaryBrush}"
                            BorderBrush="{StaticResource DarkTertiaryBrush}"
                            BorderThickness="2"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <!-- Галочка (скрыта по умолчанию) -->
                            <Path x:Name="checkMark"
                              Width="14"
                              Height="14"
                              Stretch="Fill"
                              Fill="{StaticResource PrimaryRedBrush}"
                              Data="M0,6 L5,11 L14,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Opacity="0"/>
                        </Border>

                        <!-- Текст -->
                        <ContentPresenter x:Name="contentPresenter"
                                      Grid.Column="1"
                                      Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Состояние "отмечен" -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkMark" Property="Opacity" Value="1"/>
                            <Setter TargetName="checkBoxBorder" Property="Background" Value="{StaticResource DarkTertiaryBrush}"/>
                        </Trigger>

                        <!-- Наведение мыши -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{StaticResource PrimaryRedBrush}"/>
                            <Setter TargetName="checkBoxBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF0000" BlurRadius="10" Opacity="0.4" ShadowDepth="0"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Отключенное состояние -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter TargetName="checkBoxBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для CheckBox с градиентной обводкой -->
    <Style x:Key="OutlinedCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Фон галочки с градиентной обводкой -->
                        <Border x:Name="checkBoxBorder"
                            Grid.Column="0"
                            Width="22"
                            Height="22"
                            Background="{StaticResource DarkSecondaryBrush}"
                            BorderBrush="{StaticResource OutlineBorderGradient}"
                            BorderThickness="2"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                            <!-- Галочка -->
                            <Path x:Name="checkMark"
                              Width="14"
                              Height="14"
                              Stretch="Fill"
                              Fill="{StaticResource OutlineBorderGradient}"
                              Data="M0,6 L5,11 L14,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Opacity="0"/>
                        </Border>

                        <!-- Текст -->
                        <ContentPresenter x:Name="contentPresenter"
                                      Grid.Column="1"
                                      Margin="10,0,0,0"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkMark" Property="Opacity" Value="1"/>
                            <Setter TargetName="checkBoxBorder" Property="Background" Value="#15FF0000"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="{StaticResource OutlineBorderHoverGradient}"/>
                            <Setter TargetName="checkBoxBorder" Property="Background" Value="#10FF0000"/>
                            <Setter TargetName="checkBoxBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF0000" BlurRadius="10" Opacity="0.4" ShadowDepth="0"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter TargetName="checkBoxBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для CheckBox с красным акцентом (компактный) -->
    <Style x:Key="RedCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="checkBoxBorder"
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            Background="Transparent"
                            BorderBrush="{StaticResource PrimaryRedBrush}"
                            BorderThickness="2"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <Path x:Name="checkMark"
                              Width="12"
                              Height="12"
                              Stretch="Fill"
                              Fill="{StaticResource PrimaryRedBrush}"
                              Data="M0,6 L5,11 L14,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Opacity="0"/>
                        </Border>

                        <ContentPresenter x:Name="contentPresenter"
                                      Grid.Column="1"
                                      Margin="8,0,0,0"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkMark" Property="Opacity" Value="1"/>
                            <Setter TargetName="checkBoxBorder" Property="Background" Value="#15FF0000"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="checkBoxBorder" Property="Background" Value="#10FF0000"/>
                            <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#FF4444"/>
                            <Setter TargetName="checkBoxBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF0000" BlurRadius="8" Opacity="0.4" ShadowDepth="0"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="checkBoxBorder" Property="Background" Value="#25FF0000"/>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter TargetName="checkBoxBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для CheckBox в стиле Switch/Toggle -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Переключатель -->
                        <Border x:Name="switchBorder"
                            Grid.Column="0"
                            Width="48"
                            Height="24"
                            Background="{StaticResource DarkTertiaryBrush}"
                            BorderBrush="{StaticResource DarkTertiaryBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            SnapsToDevicePixels="True">
                            <!-- Кружок переключателя -->
                            <Ellipse x:Name="switchThumb"
                                 Width="18"
                                 Height="18"
                                 Fill="{StaticResource TextSecondaryBrush}"
                                 HorizontalAlignment="Left"
                                 Margin="3,0,0,0"/>
                        </Border>

                        <ContentPresenter x:Name="contentPresenter"
                                      Grid.Column="1"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      RecognizesAccessKey="True"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Включенное состояние -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="switchBorder" Property="Background" Value="{StaticResource PrimaryRedBrush}"/>
                            <Setter TargetName="switchBorder" Property="BorderBrush" Value="{StaticResource PrimaryRedBrush}"/>
                            <Setter TargetName="switchThumb" Property="Fill" Value="White"/>
                            <Setter TargetName="switchThumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="switchThumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>

                        <!-- Наведение мыши -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="switchBorder" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FF0000" BlurRadius="10" Opacity="0.4" ShadowDepth="0"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Отключенное состояние -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter TargetName="switchBorder" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для DatePickerTextBox -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <Border Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" 
                                  VerticalAlignment="Center"
                                  Margin="15,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="IBeam"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для DatePicker -->
    <Style x:Key="BaseDatePickerStyle" TargetType="DatePicker">
        <Setter Property="Background" Value="{StaticResource DarkSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DarkTertiaryBrush}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Текст выбранной даты -->
                            <DatePickerTextBox x:Name="PART_TextBox"
                                          Grid.Column="0"
                                          Background="Transparent"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          VerticalContentAlignment="Center"
                                          HorizontalContentAlignment="Left"
                                          BorderThickness="0"/>

                            <!-- Кнопка календаря -->
                            <Button x:Name="PART_Button"
                                Grid.Column="1"
                                Width="40"
                                Height="35"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                IsTabStop="False">
                                <Button.Content>
                                    <!-- Слот для иконки календаря -->
                                    <Image Source="/Resources/Images/ic_calendar.png"
                                       Width="18"
                                       Height="18"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"/>
                                </Button.Content>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                            CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#15FF0000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- При наведении мыши -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryRedBrush}"/>
                        </Trigger>

                        <!-- При фокусе -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryRedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для Calendar (выпадающий календарь) -->
    <Style TargetType="Calendar">
        <Setter Property="Background" Value="{StaticResource DarkSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DarkTertiaryBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="14"
                        Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Заголовок с навигацией -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Кнопка предыдущего месяца -->
                                <Button x:Name="PART_PreviousButton"
                                    Grid.Column="0"
                                    Width="30"
                                    Height="30"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    IsTabStop="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#15FF0000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Content>
                                        <Image Source="/Resources/Images/ic_previous.png"
                                           Width="14"
                                           Height="14"/>
                                    </Button.Content>
                                </Button>

                                <!-- Заголовок месяца/года -->
                                <Button x:Name="PART_HeaderButton"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand"
                                    IsTabStop="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8"
                                                Padding="10,5">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#15FF0000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Кнопка следующего месяца -->
                                <Button x:Name="PART_NextButton"
                                    Grid.Column="2"
                                    Width="30"
                                    Height="30"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    IsTabStop="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#15FF0000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Content>
                                        <Image Source="/Resources/Images/ic_next.png"
                                           Width="14"
                                           Height="14"/>
                                    </Button.Content>
                                </Button>
                            </Grid>

                            <!-- Сетка дней -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Дни недели -->
                                <Grid Grid.Row="0" Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="Пн" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7"/>
                                    <TextBlock Grid.Column="1" Text="Вт" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7"/>
                                    <TextBlock Grid.Column="2" Text="Ср" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7"/>
                                    <TextBlock Grid.Column="3" Text="Чт" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7"/>
                                    <TextBlock Grid.Column="4" Text="Пт" HorizontalAlignment="Center" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.7"/>
                                    <TextBlock Grid.Column="5" Text="Сб" HorizontalAlignment="Center" FontSize="12" Foreground="#FF6666" Opacity="0.7"/>
                                    <TextBlock Grid.Column="6" Text="Вс" HorizontalAlignment="Center" FontSize="12" Foreground="#FF6666" Opacity="0.7"/>
                                </Grid>

                                <!-- Дни месяца -->
                                <Grid Grid.Row="1" x:Name="PART_MonthView"/>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для CalendarDayButton (дни в календаре) -->
    <Style TargetType="CalendarDayButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="35"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Сегодняшний день -->
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryRedBrush}"/>
                            <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                        </Trigger>

                        <!-- Выбранный день -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryRedBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>

                        <!-- Наведение мыши -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#15FF0000"/>
                        </Trigger>

                        <!-- Неактивные дни (другие месяцы) -->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="#555555"/>
                        </Trigger>

                        <!-- День заблокирован (IsBlackedOut) -->
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter Property="Foreground" Value="#333333"/>
                            <Setter Property="IsEnabled" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для CalendarButton (кнопки месяца/года) -->
    <Style TargetType="CalendarButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#15FF0000"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#25FF0000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--#endregion-->
    
</ResourceDictionary>