<UserControl x:Class="VideohostingPanel.Views.Elements.VideoItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource DarkTertiaryBrush}"
            CornerRadius="15" Margin="0,0,0,15"
            BorderBrush="{StaticResource PrimaryPurpleBrush}" BorderThickness="1"
            Cursor="Hand" MouseLeftButtonUp="Border_Click">

        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Source="{Binding PosterUrl}" Width="80" Height="45" Grid.Column="0"
                   Stretch="UniformToFill" Margin="0,0,15,0"
                   VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Автор ID:" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding AuthorId}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryPurpleBrush}" Margin="5,0,10,0"/>
                    <TextBlock Text="Вериф.:" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding IsVerified}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryRedBrush}" Margin="5,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>