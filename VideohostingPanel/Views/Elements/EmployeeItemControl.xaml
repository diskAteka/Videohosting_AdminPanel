<UserControl x:Class="VideohostingPanel.Views.Elements.EmployeeItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/VideohostingPanel;component/Resources/Styles/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource DarkTertiaryBrush}"
            CornerRadius="15" Margin="0,0,0,15"
            BorderBrush="{StaticResource PrimaryPurpleBrush}" BorderThickness="1"
            Cursor="Hand">
        <Border.InputBindings>
            <MouseBinding MouseAction="LeftClick" Command="{Binding OpenEditWindowCommand}"/>
        </Border.InputBindings>

        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image Source="/Resources/Images/ic_person.png" Width="40" Height="40" Margin="0,0,15,0"
                   VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding UserName}" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="Роль: "/>
                    <Run Text="{Binding Role}" Foreground="{StaticResource PrimaryPurpleBrush}" FontWeight="SemiBold"/>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>